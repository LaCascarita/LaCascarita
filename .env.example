VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_URL=http://localhost:3001
VITE_API_FOOTBALL_KEY=your_api_football_key

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=your_mercado_pago_access_token

# SPEI / Transferencia bancaria (datos mostrados al usuario)
SPEI_BANK_NAME=your_bank_name
SPEI_ACCOUNT_NUMBER=your_account_number
SPEI_CLABE=your_clabe_18_digits
SPEI_BENEFICIARY=your_beneficiary_name

# Openpay (sandbox o producción)
OPENPAY_MERCHANT_ID=your_openpay_merchant_id
OPENPAY_PRIVATE_KEY=your_openpay_private_key
OPENPAY_PUBLIC_KEY=your_openpay_public_key
OPENPAY_BASE_URL=https://sandbox-api.openpay.mx/v1

# Vercel (autoasignado en producción)
VERCEL_URL=your_vercel_deployment_url
# Simulacion de dispersiones (solo pruebas; dejar en false en produccion)
SIMULATE_PAYOUTS=false
